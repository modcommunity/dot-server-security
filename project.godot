; dot-server-security — hardening a dedicated server, as configuration.
;
; The distributable is `addons/dot_server_security/`. This project exists so the
; addon can be opened and validated standalone.
;
; `addons/dot_core/` and `addons/dot_server/` are required; `dot_moderation`,
; `dot_chat` and `dot_auth` are OPTIONAL and are linked here only so the self-test
; can run the bridges against the real addons rather than against stubs. All three
; are duck-typed and named nowhere in the source. See CLAUDE.md.

config_version=5

[application]

config/name="dot-server-security"
config/description="Server hardening as configuration: sliding-window rules over chat, connections, authentication and RCON, with escalating automatic punishment."
config/version="0.1.0"
run/main_scene="res://examples/security_selftest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_core/plugin.cfg", "res://addons/dot_server/plugin.cfg", "res://addons/dot_server_security/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
