; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="dot-server-security"
config/description="Server hardening as configuration: sliding-window rules over chat, connections, authentication and RCON, with escalating automatic punishment."
config/version="0.1.0"
run/main_scene="res://examples/security_selftest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_core/plugin.cfg", "res://addons/dot_server/plugin.cfg", "res://addons/dot_server_security/plugin.cfg")

[importer_defaults]

texture={
"detect_3d/compress_to": 0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
